{
  "schema": "agentos.policy.v0",
  "workdir": "/var/lib/agentos/work",
  "extra_read": [],
  "allow_commands": [
    "ls",
    "cat",
    "head",
    "tail",
    "grep",
    "wc",
    "mkdir",
    "mv",
    "cp",
    "echo",
    "tee"
  ],
  "network": false,
  "backend": "auto",
  "max_steps": 24
}