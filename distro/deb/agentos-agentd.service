# AgentOS 运行时服务（deb 版：以 agentos 系统用户运行）
[Unit]
Description=AgentOS agent runtime (policy-enforced exec + signed ledger)
After=local-fs.target

[Service]
Type=simple
User=agentos
Group=agentos
UMask=0077
ExecStart=/usr/bin/agentd --state-dir /var/lib/agentos --socket /run/agentos/agentd.sock
Restart=on-failure
RestartSec=3

# ---- 加固（纵深防御；笼内子进程同属本 cgroup） ----
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallArchitectures=native
ReadWritePaths=/var/lib/agentos
ReadWritePaths=/run/agentos
ReadWritePaths=/var/lib/agentos/work

[Install]
WantedBy=multi-user.target
